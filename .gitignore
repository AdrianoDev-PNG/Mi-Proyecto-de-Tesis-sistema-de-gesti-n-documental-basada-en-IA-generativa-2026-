Thumbs.db

# Env files (ANY folder)
*.env
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt

